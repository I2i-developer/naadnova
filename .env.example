# Configure these in Vercel Project Settings > Environment Variables as well.
NEXT_PUBLIC_SITE_URL=https://naadnova.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Alternatively, use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY with a publishable key.
# Server-only: used for private video upload and signing operations.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_WHATSAPP_NUMBER=your-whatsapp-number-with-country-code
# Server-only email delivery; CONTACT_EMAIL_FROM must be a Resend-verified sender.
RESEND_API_KEY=your-resend-api-key
CONTACT_EMAIL_FROM=Naadnova Academy <enquiries@your-verified-domain.example>
